<configuration scan="true" scanPeriod="1 seconds">
<conversionRule conversionWord="traceId" converterClass="com.dream11.odin.logging.TraceIdConverter"/>
<appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
  <encoder>
    <pattern>
      %date %highlight(%+5level) %traceId %-26thread %logger{36} [%file:%line] %green(%msg) %n
    </pattern>
  </encoder>
</appender>

<logger name="com.dream11" level="info"/>
<logger name="io.netty" level="info"/>
<logger name="io.grpc.netty" level="info"/>
<logger name="software.amazon" level="info"/>
<logger name="com.amazonaws" level="info"/>


<root level="${ODIN_LOG_LEVEL:-info}">
  <appender-ref ref="STDOUT" />
</root>

</configuration>
